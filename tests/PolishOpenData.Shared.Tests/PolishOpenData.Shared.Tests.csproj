<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT'">net10.0;net472</TargetFrameworks>
  </PropertyGroup>
  <ItemGroup>
    <!-- compile the internal shared sources directly into the test assembly -->
    <Compile Include="..\..\src\Shared\**\*.cs" LinkBase="SharedUnderTest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="Microsoft.Bcl.TimeProvider" />
    <PackageReference Include="Polyfill" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\PolishOpenData.Core\PolishOpenData.Core.csproj" />
  </ItemGroup>
</Project>
