<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- A newly published CVE must not break CI; Dependabot handles upgrades. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- CA1716: public parameter names date (IBialaListaClient) and register (IKrsClient) and the namespace
         PolishOpenData.Shared.Tests are VB keywords; kept on purpose. -->
    <NoWarn>$(NoWarn);CA1716</NoWarn>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <!-- Polyfill (netstandard2.0/net472): embedded internal types avoid clashes; enables ArgumentNullException.ThrowIfNull etc. -->
    <PolyUseEmbeddedAttribute>true</PolyUseEmbeddedAttribute>
    <PolyArgumentExceptions>true</PolyArgumentExceptions>
  </PropertyGroup>
</Project>
