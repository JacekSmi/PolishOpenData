<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <RootNamespace>PolishOpenData.Uug</RootNamespace>
    <Description>Typed .NET client for UUG (the address geocoder at services.gugik.gov.pl/uug) of GUGiK: geocode a Polish address to a WGS-84 point with a match accuracy, and reverse-geocode a point to the nearest address. Unofficial; not affiliated with the Polish government.</Description>
    <PackageTags>$(PackageTags);uug;gugik;geocoding;address;teryt</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
    <PackageReference Include="Microsoft.Bcl.TimeProvider" />
    <PackageReference Include="Portable.System.DateTimeOnly" />
    <PackageReference Include="Polyfill" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PolishOpenData.Core\PolishOpenData.Core.csproj" />
    <ProjectReference Include="..\PolishOpenData.Geo.Core\PolishOpenData.Geo.Core.csproj" />
    <Compile Include="..\Shared\**\*.cs" LinkBase="Shared" />
    <InternalsVisibleTo Include="PolishOpenData.Uug.Tests" />
  </ItemGroup>
</Project>
