<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <RootNamespace>PolishOpenData.Bir</RootNamespace>
    <Description>Typed .NET client for the Polish REGON register (GUS BIR1.2 web service): search by NIP, REGON or KRS, batches of up to 20, full reports of legal persons, sole traders and local units, session handling and a request limiter. Needs your own free GUS key (the public test environment works without one). Unofficial; not affiliated with GUS or the Polish government.</Description>
    <PackageTags>$(PackageTags);gus;bir;regon-api;soap;company-register;due-diligence</PackageTags>
    <!-- No release of this package exists on nuget.org yet, so there is nothing to compare against. After 1.2.0 is
         published, delete this line; the baseline in src/Directory.Build.props then applies (raise it first). -->
    <PackageValidationBaselineVersion />
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
    <PackageReference Include="Microsoft.Bcl.TimeProvider" />
    <PackageReference Include="Portable.System.DateTimeOnly" />
    <PackageReference Include="Polyfill" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PolishOpenData.Core\PolishOpenData.Core.csproj" />
    <Compile Include="..\Shared\**\*.cs" LinkBase="Shared" />
    <InternalsVisibleTo Include="PolishOpenData.Regon.Tests" />
  </ItemGroup>
</Project>
