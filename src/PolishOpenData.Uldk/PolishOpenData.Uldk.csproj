<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <RootNamespace>PolishOpenData.Uldk</RootNamespace>
    <Description>Typed .NET client for ULDK (Usługa Lokalizacji Działek Katastralnych, uldk.gugik.gov.pl) of GUGiK: find a cadastral parcel by its TERYT identifier or by a point, with its boundary as WKT. Unofficial; not affiliated with the Polish government.</Description>
    <PackageTags>$(PackageTags);uldk;gugik;cadastre;parcel;teryt</PackageTags>
    <!-- No release of this package exists on nuget.org yet, so there is nothing to compare against. After 1.4.0 is published, delete this line; the baseline in src/Directory.Build.props then applies (raise it first). -->
    <PackageValidationBaselineVersion />
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
    <PackageReference Include="Microsoft.Bcl.TimeProvider" />
    <PackageReference Include="Portable.System.DateTimeOnly" />
    <PackageReference Include="Polyfill" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PolishOpenData.Core\PolishOpenData.Core.csproj" />
    <ProjectReference Include="..\PolishOpenData.Geo.Core\PolishOpenData.Geo.Core.csproj" />
    <Compile Include="..\Shared\**\*.cs" LinkBase="Shared" />
    <InternalsVisibleTo Include="PolishOpenData.Uldk.Tests" />
  </ItemGroup>
</Project>
