<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <RootNamespace>PolishOpenData.Krs</RootNamespace>
    <Description>Typed .NET client for the KRS Open API (Krajowy Rejestr Sądowy, api-krs.ms.gov.pl): current and full extracts, removal status, daily change feed and an English company summary. Unofficial.</Description>
    <PackageTags>$(PackageTags);krs-api;company-register;due-diligence</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
    <PackageReference Include="Microsoft.Bcl.TimeProvider" />
    <PackageReference Include="Portable.System.DateTimeOnly" />
    <PackageReference Include="Polyfill" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PolishOpenData.Core\PolishOpenData.Core.csproj" />
    <Compile Include="..\Shared\**\*.cs" LinkBase="Shared" />
    <InternalsVisibleTo Include="PolishOpenData.Krs.Tests" />
  </ItemGroup>
</Project>
