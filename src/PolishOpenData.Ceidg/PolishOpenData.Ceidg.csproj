<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <RootNamespace>PolishOpenData.Ceidg</RootNamespace>
    <Description>Typed .NET client for the CEIDG v3 API (Centralna Ewidencja i Informacja o Działalności Gospodarczej, the register of sole traders, dane.biznes.gov.pl): look up a business by NIP, REGON or id, with status, dates, address and PKD codes. You need your own free API token. Unofficial; not affiliated with the Polish government.</Description>
    <PackageTags>$(PackageTags);ceidg;sole-trader;company-register;due-diligence</PackageTags>
    <!-- New package: no release to compare with yet, and the shared baseline predates it. Delete this override (and its line) once the first Ceidg version is on nuget.org, or the package is never baseline-validated. -->
    <PackageValidationBaselineVersion></PackageValidationBaselineVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="System.Text.Json" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
    <PackageReference Include="Microsoft.Bcl.TimeProvider" />
    <PackageReference Include="Portable.System.DateTimeOnly" />
    <PackageReference Include="Polyfill" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PolishOpenData.Core\PolishOpenData.Core.csproj" />
    <Compile Include="..\Shared\**\*.cs" LinkBase="Shared" />
    <InternalsVisibleTo Include="PolishOpenData.Ceidg.Tests" />
  </ItemGroup>
</Project>
