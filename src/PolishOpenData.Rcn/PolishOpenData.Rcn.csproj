<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <RootNamespace>PolishOpenData.Rcn</RootNamespace>
    <Description>Typed .NET client for RCN (Rejestr Cen Nieruchomości) of GUGiK: real-estate transaction prices of premises, parcels and buildings from the national WFS, with price-per-square-metre statistics. Unofficial; not affiliated with the Polish government.</Description>
    <PackageTags>$(PackageTags);rcn;gugik;real-estate;transaction-prices;wfs</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
    <PackageReference Include="Microsoft.Bcl.TimeProvider" />
    <PackageReference Include="Portable.System.DateTimeOnly" />
    <PackageReference Include="Polyfill" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PolishOpenData.Core\PolishOpenData.Core.csproj" />
    <ProjectReference Include="..\PolishOpenData.Geo.Core\PolishOpenData.Geo.Core.csproj" />
    <Compile Include="..\Shared\**\*.cs" LinkBase="Shared" />
    <InternalsVisibleTo Include="PolishOpenData.Rcn.Tests" />
  </ItemGroup>
</Project>
