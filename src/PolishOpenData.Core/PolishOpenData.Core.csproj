<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <RootNamespace>PolishOpenData</RootNamespace>
    <Description>Offline parsing and validation of Polish identifiers: NIP, REGON, KRS number, NRB bank account and land-registry (księga wieczysta, KW) numbers with the official court-code table. Unofficial; not affiliated with the Polish government.</Description>
    <PackageTags>$(PackageTags);validation;identifiers</PackageTags>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" />
    <PackageReference Include="Portable.System.DateTimeOnly" />
    <PackageReference Include="Polyfill" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\kw-courts.tsv" LogicalName="PolishOpenData.kw-courts.tsv" />
  </ItemGroup>
</Project>
