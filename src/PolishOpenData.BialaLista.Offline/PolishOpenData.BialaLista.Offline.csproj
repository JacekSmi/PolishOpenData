<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <RootNamespace>PolishOpenData.BialaLista.Offline</RootNamespace>
    <Description>Offline check of a Polish VAT taxpayer and bank account against the Ministry of Finance daily plik płaski (flat file): downloads and indexes the file once per day, then answers Active, Exempt or NotFound locally without the REST API's request limit. Unofficial; not affiliated with the Polish government.</Description>
    <PackageTags>$(PackageTags);wykaz-podatnikow;whitelist;split-payment;plik-plaski;flat-file;offline</PackageTags>
    <!-- No release of this package exists on nuget.org yet, so there is nothing to compare against. After 1.3.0 is published, delete this line; the baseline in src/Directory.Build.props then applies (raise it first). -->
    <PackageValidationBaselineVersion />
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="SharpCompress" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
    <PackageReference Include="Microsoft.Bcl.TimeProvider" />
    <PackageReference Include="Portable.System.DateTimeOnly" />
    <PackageReference Include="Polyfill" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PolishOpenData.Core\PolishOpenData.Core.csproj" />
    <Compile Include="..\Shared\**\*.cs" LinkBase="Shared" />
    <InternalsVisibleTo Include="PolishOpenData.BialaLista.Offline.Tests" />
    <InternalsVisibleTo Include="PolishOpenData.Benchmarks" />
  </ItemGroup>
</Project>
