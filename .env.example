# Copy to ".env" (git-ignored) and fill in the values you have. Read only by the live smoke tests
# (tests/PolishOpenData.SmokeTests); variables already set in your shell win. Never commit real values.

# Set to 1 to run the live tests at all.
POLISHOPENDATA_SMOKE=1

# Your own CEIDG API token (personal; from biznes.gov.pl, e-service 00_9999_00). Optional: skips the CEIDG test without it.
POLISHOPENDATA_CEIDG_TOKEN=
# A NIP that is in CEIDG (your own), for the second CEIDG request. Optional.
POLISHOPENDATA_CEIDG_NIP=

# Your own GUS BIR production key. Optional: skips the production REGON tests without it.
POLISHOPENDATA_REGON_KEY=
